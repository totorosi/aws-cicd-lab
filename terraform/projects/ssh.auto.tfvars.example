# SSH 접속 허용 대역.
#
# 이 파일을 ssh.auto.tfvars 로 복사한 뒤 본인 공인 IP 로 바꿔 쓴다.
# *.auto.tfvars 는 .gitignore 에 있어 저장소에 올라가지 않는다.
# terraform 이 자동으로 읽으므로 -var-file 지정이 필요 없다.
#
#   cp ssh.auto.tfvars.example ssh.auto.tfvars
#
# 빈 리스트로 두면 아무도 SSH 로 접속할 수 없다(SSM Session Manager 는 그대로 사용 가능).
ssh_allowed_cidrs = ["203.0.113.10/32"]
